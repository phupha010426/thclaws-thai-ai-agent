FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/thaiagent-api ./cmd/api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/thaiagent-api /thaiagent-api
EXPOSE 3000
USER nonroot:nonroot
ENTRYPOINT ["/thaiagent-api"]
