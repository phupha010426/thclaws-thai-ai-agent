APP_NAME=ThaiAiAgent
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
PUBLIC_BASE_URL=https://thaiaiagent.smlsoft.app

# LINE OA
LINE_CHANNEL_ACCESS_TOKEN=<LINE_CHANNEL_ACCESS_TOKEN>
LINE_CHANNEL_SECRET=<LINE_CHANNEL_SECRET>
LIFF_ID=
LIFF_CHANNEL_ID=

# Databases
POSTGRES_URL=postgresql://thaiaiagent:thaiaiagent@localhost:5432/thaiaiagent?schema=public
POSTGRES_USER=thaiaiagent
POSTGRES_PASSWORD=thaiaiagent
POSTGRES_DB=thaiaiagent
MONGODB_URL=mongodb://root:example@localhost:27017/thaiaiagent?authSource=admin
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
REDIS_URL=redis://localhost:6379
REDIS_QUEUE_PREFIX=thaiaiagent

# Object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=thaiaiagent
MINIO_SECRET_KEY=thaiaiagent-dev-secret
MINIO_BUCKET=thaiaiagent
IMAGE_ACCESS_SECRET=change-me-long-random-image-signing-secret

# Agent runtime
DEFAULT_AGENT_MODEL=sml/auto
FAST_AGENT_MODEL=sml/fast
GENERAL_AGENT_MODEL=sml/thai
VISION_AGENT_MODEL=sml/auto
TEXT_FALLBACK_MODELS=groq/meta-llama/llama-4-scout-17b-16e-instruct,groq/llama-3.1-8b-instant
VISION_FALLBACK_MODELS=mistral/mistral-medium-3-5,groq/meta-llama/llama-4-scout-17b-16e-instruct
THCLAWS_GATEWAY_URL=http://localhost:8787
THCLAWS_API_KEY=dev-key
THCLAWS_TIMEOUT_MS=30000
LINE_REPLY_TIMEOUT_MS=35000
SMLGATEWAY_MAX_LATENCY_MS=3000
SMLGATEWAY_PREFER_PROVIDERS=typhoon,thaillm,groq,cerebras
SMLGATEWAY_TEXT_EXCLUDE_PROVIDERS=mistral

# Go core service (deterministic parsers, future MCP/event hub)
# Empty in dev to keep Node parsers; set in prod compose to http://core:8080
CORE_BASE_URL=
CORE_TIMEOUT_MS=2000

# NATS JetStream — events bus. Empty disables publishing (callers degrade silently).
NATS_URL=
NATS_STREAM_NAME=thaiagent

# Embedding model (1024-dim) for memory_embeddings + semantic search.
EMBEDDING_MODEL=bge-m3
EMBEDDING_FALLBACK_MODELS=cohere/embed-multilingual-v3.0,openai/text-embedding-3-large

# Security
WEBHOOK_REPLAY_WINDOW_SECONDS=300
WEBHOOK_BODY_LIMIT=1mb
